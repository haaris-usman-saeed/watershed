# Copy into the hosting provider's secrets box (Streamlit Community Cloud: App settings > Secrets).
# Root-level keys are exposed to the app as environment variables. Never commit real values.
WATERSHED_DEPLOYMENT = "public"
WATERSHED_ARTIFACT_URL = "https://github.com/haaris-usman-saeed/watershed/releases/download/models-2026-11-22/watershedshift_models_<hash>.tar.gz"
WATERSHED_ARTIFACT_SHA256 = "<64-hex SHA-256 printed by python -m src.v3_artifacts pack>"
# Optional: private bucket instead of a public release asset
# WATERSHED_ARTIFACT_TOKEN = "<bearer token>"
# Optional: persistent forecast history (otherwise records live only until the app restarts).
# Recommended: a separate GitHub repository and a fine-grained token limited to it (Contents: read and write).
# See docs/v3/DEPLOYMENT.md, "Persistent records in a GitHub repository".
# WATERSHED_RECORD_GITHUB_REPO = "<owner>/watershed-records"
# WATERSHED_RECORD_GITHUB_TOKEN = "<fine-grained token>"
# Alternative: an S3 bucket (needs boto3, not installed yet)
# WATERSHED_RECORD_BUCKET = "<bucket name>"
# AWS_ACCESS_KEY_ID = "<key>"
# AWS_SECRET_ACCESS_KEY = "<secret>"
# AWS_DEFAULT_REGION = "us-east-1"
