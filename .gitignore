.DS_Store

# full-resolution local copies (contain CDEC-derived storage values; not for public repo)
results/*/local_full/
dist/

# rehearsal UI copies contain CDEC-derived storage values
results/v2/rehearsal/ui_outputs_rehearsal/

# 30-day research forecasts: live CDEC downloads and local forecast snapshots (kept local; published copies go through public_data/)
data/live/
forecasts/

# v3: private CDEC-derived tables, caches, raw weather downloads and logs. Publishable derived data is
# released through src/v3_release.py into public_data/ (write-once, policy-checked).
data/v3/

# v4 (NeuralHydro research): private daily panel, CDEC flow downloads, per-row predictions, checkpoints,
# and the separate PyTorch environment. Aggregate results go to results/v4/ (tracked).
data/v4/
.venv-v4/

# Prospective scoring (src/prospective.py): raw CDEC responses kept with their SHA-256 on the scoring machine.
data/prospective/

# v5 (consolidated benchmark): private daily panel and feature tables, CDEC flow downloads for 2024-2026,
# per-row predictions and run logs. Model artifacts go to models/v5/ (ignored above); aggregates to results/v5/.
data/v5/
